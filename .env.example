# ==========================================
# 声音采集与标注系统 (Voice Collection & Annotation System)
# 环境变量配置模板
# ==========================================

# ---------- 存储配置 (Storage Configuration) ----------
# 可选值: local (本地存储) 或 aliyun (阿里云 OSS)
STORAGE_TYPE=aliyun

# 阿里云 OSS 配置 (仅当 STORAGE_TYPE=aliyun 时生效)
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_BUCKET_NAME=your_bucket_name
ALIYUN_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ---------- 数据库配置 (Database Configuration) ----------
# 生产环境推荐 MySQL (如 mysql+pymysql://username:password@localhost:3306/dbname)
# 开发/轻量级部署支持 SQLite (如 sqlite:///./app.db)
DATABASE_URL=mysql+pymysql://voice_admin:your_db_password@localhost:3306/voice_db

# ---------- 缓存配置 (Cache Configuration) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 安全与权限配置 (Security & Permissions) ----------
# 超级主密码 / 全局操作授权码
MASTER_PASSWORD=your_secure_master_password

# 初始超级管理员账号信息
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=your_secure_admin_password

# 功能特性标记 (Feature Flags: 1=基础模式, 2=角色完整模式)
ROLE_FEATURE_FLAG=2
